# CaseWeaver backend configuration (demo defaults require NO external keys)

# Persistence: sqlite path (repository layer isolates this so it can be swapped)
CASEWEAVER_DB_PATH=./caseweaver.db

# Where original uploaded evidence bytes are stored (kept separate from derived data)
CASEWEAVER_STORAGE_DIR=./storage

# Upload guard-rails
CASEWEAVER_MAX_UPLOAD_BYTES=8388608
CASEWEAVER_ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf,txt,csv,json,eml

# Mode: demo (fully synthetic/local) | local | live
CASEWEAVER_MODE=demo

# Optional live integrations. Leave blank to run the deterministic demo.
# When blank, Research Center uses the local mock adapter and labels results as simulated.
OPENAI_API_KEY=
SEARCHAPI_API_KEY=
